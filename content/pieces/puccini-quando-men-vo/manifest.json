 "passages": [
  {
   "id": "a",
   "label": "Quando me'n vo' soletta per la via: Musetta's waltz (Tempo di valzer lento); Legatemi alla seggiola!",
   "start": "1",
   "end": "16"
  },
  {
   "id": "b",
   "label": "Ed assaporo allor la bramosia sottil... felice mi fa! (Alcindoro: Quel canto scurrile, C)",
   "start": "17",
   "end": "32"
  },
  {
   "id": "c",
   "label": "E tu che sai, che memorie ti struggi: Io vedo ben, che quella poveretta",
   "start": "33",
   "end": "47"
  },
  {
   "id": "d",
   "label": "Marcello un dì l'amò: the ensemble begins (appena animando)",
   "start": "48",
   "end": "56"
  },
  {
   "id": "e",
   "label": "Ah! Marcello smania: Marcello is beaten (poco sostenuto, figure 24)",
   "start": "57",
   "end": "64"
  },
  {
   "id": "f",
   "label": "So ben, le angoscie tue: the waltz in full; Or convien liberarsi del vecchio!",
   "start": "65",
   "end": "77"
  }
 ],
